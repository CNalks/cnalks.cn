---
import "../styles/global.css";
import payloadJson from "../data/siming-alerts.json";

const payload = payloadJson as any;
const district = payload.district.analysis;
const weekly = payload.district.weekly;
const forecast = district.forecast || [];
const streets = payload.streets || [];
const communities = payload.top_communities || [];

const width = 1120;
const height = 430;
const margin = { top: 34, right: 34, bottom: 58, left: 62 };
const plotW = width - margin.left - margin.right;
const plotH = height - margin.top - margin.bottom;
const values = [...weekly.map((d: any) => d.count), ...forecast.map((d: any) => d.count)];
const maxY = Math.max(10, Math.ceil(Math.max(...values) / 100) * 100);
const minY = 0;
const allX = [...weekly, ...forecast];
const x = (index: number) => margin.left + (index / Math.max(1, allX.length - 1)) * plotW;
const y = (value: number) => margin.top + (1 - (value - minY) / Math.max(1, maxY - minY)) * plotH;
const actualPts = weekly.map((d: any, i: number) => ({ ...d, x: x(i), y: y(d.count) }));
const forecastPts = forecast.map((d: any, i: number) => ({ ...d, x: x(weekly.length + i), y: y(d.count) }));
const joinedForecastPts = actualPts.length && forecastPts.length ? [actualPts[actualPts.length - 1], ...forecastPts] : forecastPts;

function smoothPath(points: any[]) {
  if (points.length < 2) return "";
  const path = [`M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`];
  for (let i = 0; i < points.length - 1; i += 1) {
    const p0 = points[Math.max(0, i - 1)];
    const p1 = points[i];
    const p2 = points[i + 1];
    const p3 = points[Math.min(points.length - 1, i + 2)];
    const cp1x = p1.x + (p2.x - p0.x) / 6;
    const cp1y = p1.y + (p2.y - p0.y) / 6;
    const cp2x = p2.x - (p3.x - p1.x) / 6;
    const cp2y = p2.y - (p3.y - p1.y) / 6;
    path.push(`C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)}, ${cp2x.toFixed(1)} ${cp2y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`);
  }
  return path.join(" ");
}

const actualPath = smoothPath(actualPts);
const forecastPath = smoothPath(joinedForecastPts);
const areaPath = actualPts.length
  ? `${actualPath} L ${actualPts[actualPts.length - 1].x.toFixed(1)} ${y(0).toFixed(1)} L ${actualPts[0].x.toFixed(1)} ${y(0).toFixed(1)} Z`
  : "";
const yTicks = [0, Math.round(maxY * 0.25), Math.round(maxY * 0.5), Math.round(maxY * 0.75), maxY];
const xTickIndexes = [0, 10, 20, 30, 40, weekly.length - 1].filter((item, index, arr) => item >= 0 && item < weekly.length && arr.indexOf(item) === index);
const fluStartIndex = weekly.findIndex((d: any) => d.iso_week.endsWith("W40"));
const peak = weekly.reduce((best: any, item: any) => (item.count > best.count ? item : best), weekly[0]);
const peakIndex = weekly.findIndex((d: any) => d.week_start === peak.week_start);

function pct(value: number | null) {
  if (value === null || Number.isNaN(value)) return "--";
  return `${Math.round(value * 100)}%`;
}

function metric(value: number | null, digits = 1) {
  if (value === null || Number.isNaN(value)) return "--";
  return Number(value).toLocaleString("zh-CN", { maximumFractionDigits: digits });
}

function modelLabel(name: string) {
  const labels: Record<string, string> = {
    naive_last: "最近值延续",
    moving_average_4: "4周移动均值",
    damped_trend: "阻尼趋势",
    croston_sba: "Croston-SBA",
    poisson_harmonic: "泊松谐波"
  };
  return labels[name] || name || "未入模";
}

function gateLabel(reason: string) {
  const labels: Record<string, string> = {
    eligible: "可做短期参考",
    low_total_count: "总量过低",
    too_few_nonzero_weeks: "非零周不足",
    zero_inflated_sparse: "零膨胀",
    single_spike_dominates: "尖峰主导",
    too_unstable_for_routine_forecast: "波动过强"
  };
  if (!reason || reason === "eligible") return labels.eligible;
  return reason.split(";").map((item) => labels[item] || item).join(" / ");
}

const apiProbe = payload.api_probe || {};
const apiTrain = (apiProbe.steps || []).find((step: any) => step.label === "train_poll");
const apiForecast = (apiProbe.steps || []).find((step: any) => step.label === "forecast_poll");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="思明区学校预警信号按周聚合、序列诊断、五模型短期预测实验和 AI_lab API 探针结果。" />
    <link rel="icon" href="/favicon.svg" />
    <title>思明区预警信号周序列分析 | CNalks</title>
  </head>
  <body class="analysis-body">
    <div class="analysis-page">
      <header class="analysis-topbar">
        <a class="back-link" href="/">CNalks</a>
        <nav>
          <a href="#series">序列</a>
          <a href="#models">模型</a>
          <a href="#api">AI_lab</a>
        </nav>
      </header>

      <main>
        <section class="analysis-hero">
          <div>
            <p class="analysis-kicker">weekly signal study · Siming District</p>
            <h1>思明区学校预警信号周序列分析</h1>
            <p class="analysis-copy">
              将 `处理结果` 子表按 ISO 周聚合为社区、街道和全区序列，先做可预测性筛选，再用 5 个轻量模型做滚动回测和未来两周短期参考。
            </p>
            <div class="hero-badges">
              <span>{payload.source.date_min} 至 {payload.source.date_max}</span>
              <span>按 {payload.source.date_column} 聚合</span>
              <span>不含原始明细</span>
            </div>
          </div>
          <div class="hero-metrics" aria-label="关键指标">
            <div>
              <small>记录</small>
              <strong>{payload.summary.records.toLocaleString("zh-CN")}</strong>
            </div>
            <div>
              <small>周数</small>
              <strong>{payload.summary.weeks}</strong>
            </div>
            <div>
              <small>序列</small>
              <strong>{payload.summary.series_count}</strong>
            </div>
            <div>
              <small>可入模</small>
              <strong>{payload.summary.forecast_eligible_count}</strong>
            </div>
          </div>
        </section>

        <section class="analysis-section chart-section" id="series">
          <div class="section-heading">
            <div>
              <p class="analysis-kicker">district view</p>
              <h2>全区周信号量</h2>
            </div>
            <div class="chart-legend" aria-label="图例">
              <span><i class="actual-dot"></i>观测</span>
              <span><i class="forecast-dot"></i>本地短期参考</span>
            </div>
          </div>

          <div class="chart-shell">
            <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="思明区每周预警信号数曲线">
              <rect x="0" y="0" width={width} height={height} rx="8" fill="#101713" />
              {yTicks.map((tick) => (
                <g>
                  <line x1={margin.left} x2={width - margin.right} y1={y(tick)} y2={y(tick)} stroke="rgba(229,239,232,.13)" />
                  <text x={margin.left - 14} y={y(tick) + 5} text-anchor="end" class="axis-text">{tick}</text>
                </g>
              ))}
              {fluStartIndex >= 0 && (
                <g>
                  <rect x={x(fluStartIndex)} y={margin.top} width={(width - margin.right - x(fluStartIndex)).toFixed(1)} height={plotH} fill="rgba(251,191,36,.06)" />
                  <line x1={x(fluStartIndex)} x2={x(fluStartIndex)} y1={margin.top} y2={height - margin.bottom} stroke="rgba(251,191,36,.55)" stroke-dasharray="5 7" />
                  <text x={x(fluStartIndex) + 10} y={margin.top + 18} class="axis-note">流感监测季 W40 起</text>
                </g>
              )}
              {forecastPts.length > 0 && (
                <g>
                  <rect x={forecastPts[0].x} y={margin.top} width={(width - margin.right - forecastPts[0].x).toFixed(1)} height={plotH} fill="rgba(251,113,133,.06)" />
                  <line x1={forecastPts[0].x} x2={forecastPts[0].x} y1={margin.top} y2={height - margin.bottom} stroke="rgba(251,113,133,.65)" stroke-dasharray="5 7" />
                  <text x={forecastPts[0].x + 10} y={height - margin.bottom - 12} class="axis-note">两周参考</text>
                </g>
              )}
              {areaPath && <path d={areaPath} fill="url(#actualArea)" />}
              <defs>
                <linearGradient id="actualArea" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="#7dd3fc" stop-opacity=".24" />
                  <stop offset="100%" stop-color="#7dd3fc" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path d={actualPath} fill="none" stroke="#7dd3fc" stroke-width="4" stroke-linecap="round" />
              {forecastPath && <path d={forecastPath} fill="none" stroke="#fb7185" stroke-width="4" stroke-dasharray="10 9" stroke-linecap="round" />}
              {actualPts.map((point: any, index: number) => index % 5 === 0 || point.count === peak.count ? (
                <circle cx={point.x} cy={point.y} r="4" fill="#101713" stroke="#7dd3fc" stroke-width="2">
                  <title>{point.iso_week}: {point.count}</title>
                </circle>
              ) : null)}
              {forecastPts.map((point: any) => (
                <circle cx={point.x} cy={point.y} r="5" fill="#101713" stroke="#fb7185" stroke-width="2.4">
                  <title>{point.iso_week}: {point.count}</title>
                </circle>
              ))}
              {peakIndex >= 0 && (
                <g>
                  <line x1={x(peakIndex)} x2={x(peakIndex)} y1={y(peak.count)} y2={height - margin.bottom} stroke="rgba(125,211,252,.22)" />
                  <text x={x(peakIndex) + 8} y={y(peak.count) - 10} class="axis-note">峰值 {peak.iso_week} · {peak.count}</text>
                </g>
              )}
              {xTickIndexes.map((index) => (
                <g>
                  <line x1={x(index)} x2={x(index)} y1={height - margin.bottom} y2={height - margin.bottom + 6} stroke="rgba(229,239,232,.35)" />
                  <text x={x(index)} y={height - margin.bottom + 26} text-anchor="middle" class="axis-text">{weekly[index].iso_week}</text>
                </g>
              ))}
            </svg>
          </div>

          <div class="chart-foot">
            <div>
              <strong>{modelLabel(district.best_model)}</strong>
              <span>当前全区序列滚动回测最优；MAE {metric(district.mae)}，RMSE {metric(district.rmse)}。</span>
            </div>
            <div>
              <strong>预测边界</strong>
              <span>只展示未来 {payload.summary.horizon_weeks} 周参考；51 周数据不足以支撑正式年度季节预测。</span>
            </div>
          </div>
        </section>

        <section class="analysis-section grid-two">
          <div>
            <div class="section-heading compact">
              <div>
                <p class="analysis-kicker">street ranking</p>
                <h2>街道序列</h2>
              </div>
            </div>
            <div class="rank-list">
              {streets.map((item: any) => (
                <article class="rank-row">
                  <div>
                    <strong>{item.name}</strong>
                    <span>{item.series_type} · {gateLabel(item.gate_reason)}</span>
                  </div>
                  <div class="rank-metrics">
                    <span>{item.total}</span>
                    <small>零值 {pct(item.zero_ratio)}</small>
                  </div>
                  <div class="rank-forecast">
                    <small>{modelLabel(item.best_model)}</small>
                    <strong>{item.forecast?.map((row: any) => row.count).join(" / ") || "监测"}</strong>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div id="models">
            <div class="section-heading compact">
              <div>
                <p class="analysis-kicker">model policy</p>
                <h2>筛选与模型</h2>
              </div>
            </div>
            <div class="model-panel">
              <div class="model-grid">
                {payload.summary.candidate_models.map((name: string) => (
                  <div>
                    <strong>{modelLabel(name)}</strong>
                    <span>{name}</span>
                  </div>
                ))}
              </div>
              <p>
                先按周数、总量、非零周、零值比例、尖峰占比筛掉不可预测序列。街道 10 条和全区序列全部进入短期实验，社区 101 条中 51 条进入实验，其余保留为监测序列。
              </p>
              <div class="policy-grid">
                <div><small>连续服务量</small><strong>{district.series_type}</strong></div>
                <div><small>平稳性</small><strong>{district.stationarity}</strong></div>
                <div><small>季节性</small><strong>{district.seasonality}</strong></div>
              </div>
            </div>
          </div>
        </section>

        <section class="analysis-section">
          <div class="section-heading compact">
            <div>
              <p class="analysis-kicker">community detail</p>
              <h2>高频社区 Top 30</h2>
            </div>
          </div>
          <div class="community-table">
            <div class="community-head">
              <span>社区</span>
              <span>街道</span>
              <span>总量</span>
              <span>零值</span>
              <span>策略</span>
              <span>两周参考</span>
            </div>
            {communities.map((item: any) => (
              <div class="community-row">
                <strong>{item.name}</strong>
                <span>{item.street}</span>
                <span>{item.total}</span>
                <span>{pct(item.zero_ratio)}</span>
                <span>{gateLabel(item.gate_reason)}</span>
                <span>{item.forecast?.map((row: any) => row.count).join(" / ") || "监测"}</span>
              </div>
            ))}
          </div>
        </section>

        <section class="analysis-section grid-two" id="api">
          <div class="model-panel">
            <p class="analysis-kicker">AI_lab probe</p>
            <h2>接口测试结论</h2>
            <div class="api-steps">
              <div><span>模型元数据</span><strong>HTTP 200</strong></div>
              <div><span>临时序列写入</span><strong>201 · 51 点</strong></div>
              <div><span>训练</span><strong>{apiTrain?.last_status || "unknown"}</strong></div>
              <div><span>预测运行</span><strong>{apiForecast?.last_result || apiForecast?.last_status || "unknown"}</strong></div>
              <div><span>清理</span><strong>HTTP {apiProbe.cleanup_status || "--"}</strong></div>
            </div>
            <p>
              结论：AI_lab 的通用 series/data/train 链路可用；本数据只有 51 周，低于当前预测运行 60 点门槛，因此展示页采用本地批量实验结果，AI_lab 侧记录为需补结构化 `insufficient_data` 策略。
            </p>
          </div>

          <div class="model-panel">
            <p class="analysis-kicker">data limits</p>
            <h2>解释边界</h2>
            <ul class="limits">
              {payload.limitations.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

<style>
  .analysis-body {
    background:
      radial-gradient(circle at 15% 10%, rgba(125,211,252,.18), transparent 34%),
      radial-gradient(circle at 84% 12%, rgba(251,113,133,.13), transparent 32%),
      linear-gradient(180deg, #0d1110, #121715 46%, #0f1212);
  }

  .analysis-page {
    width: min(1240px, calc(100% - 36px));
    margin: 0 auto;
    padding-bottom: 64px;
  }

  .analysis-topbar {
    height: 66px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .analysis-topbar a {
    color: var(--muted);
    text-decoration: none;
  }

  .analysis-topbar nav {
    display: flex;
    gap: 14px;
  }

  .back-link {
    font-weight: 800;
    color: var(--ink) !important;
  }

  .analysis-hero {
    min-height: 520px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    gap: 42px;
    align-items: center;
  }

  .analysis-kicker {
    margin: 0 0 10px;
    color: var(--green);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .analysis-hero h1 {
    max-width: 860px;
    margin: 0;
    font-size: clamp(40px, 7vw, 84px);
    line-height: .98;
  }

  .analysis-copy {
    max-width: 760px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hero-badges span,
  .chart-legend span {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 12px;
    color: var(--muted);
    background: rgba(255,255,255,.04);
    font-size: 13px;
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .hero-metrics div,
  .model-panel,
  .chart-shell,
  .rank-row,
  .community-table {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(16, 23, 19, .76);
    box-shadow: 0 22px 70px rgba(0,0,0,.22);
  }

  .hero-metrics div {
    padding: 24px;
  }

  .hero-metrics small,
  .rank-row small,
  .policy-grid small {
    color: var(--muted);
  }

  .hero-metrics strong {
    display: block;
    margin-top: 10px;
    font-size: clamp(32px, 4vw, 54px);
  }

  .analysis-section {
    margin-top: 28px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
  }

  .section-heading.compact {
    align-items: start;
  }

  .section-heading h2,
  .model-panel h2 {
    margin: 0;
    font-size: 28px;
  }

  .chart-shell {
    overflow: hidden;
  }

  .chart-shell svg {
    width: 100%;
    display: block;
  }

  .axis-text {
    fill: #9aa9a3;
    font-size: 13px;
  }

  .axis-note {
    fill: #cbd8d2;
    font-size: 14px;
  }

  .actual-dot,
  .forecast-dot {
    width: 18px;
    height: 3px;
    display: inline-block;
    border-radius: 999px;
    background: #7dd3fc;
  }

  .forecast-dot {
    background: #fb7185;
  }

  .chart-foot {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .chart-foot div {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 15px;
    background: rgba(255,255,255,.035);
  }

  .chart-foot strong,
  .chart-foot span {
    display: block;
  }

  .chart-foot span,
  .model-panel p,
  .rank-row span,
  .limits {
    color: var(--muted);
    line-height: 1.65;
  }

  .grid-two {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, .85fr);
    gap: 22px;
    align-items: start;
  }

  .rank-list {
    display: grid;
    gap: 10px;
  }

  .rank-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 100px 130px;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
  }

  .rank-row strong,
  .rank-row span,
  .rank-row small {
    display: block;
  }

  .rank-metrics,
  .rank-forecast {
    text-align: right;
  }

  .rank-metrics span,
  .rank-forecast strong {
    color: var(--cyan);
    font-size: 20px;
    font-weight: 780;
  }

  .rank-forecast strong {
    color: var(--coral);
  }

  .model-panel {
    padding: 22px;
  }

  .model-grid,
  .policy-grid,
  .api-steps {
    display: grid;
    gap: 10px;
  }

  .model-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 18px 0;
  }

  .model-grid div,
  .policy-grid div,
  .api-steps div {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 13px;
    background: rgba(255,255,255,.035);
  }

  .model-grid strong,
  .model-grid span,
  .api-steps span,
  .api-steps strong {
    display: block;
  }

  .model-grid span,
  .api-steps span {
    margin-top: 4px;
    color: var(--muted);
    font-size: 13px;
  }

  .policy-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 16px;
  }

  .policy-grid strong {
    display: block;
    margin-top: 6px;
    overflow-wrap: anywhere;
  }

  .community-table {
    overflow: hidden;
  }

  .community-head,
  .community-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr .55fr .55fr 1.15fr .8fr;
    gap: 12px;
    align-items: center;
    padding: 13px 16px;
  }

  .community-head {
    color: var(--muted);
    background: rgba(255,255,255,.055);
    font-size: 13px;
  }

  .community-row {
    border-top: 1px solid var(--line);
  }

  .community-row span {
    color: var(--muted);
  }

  .api-steps {
    margin: 18px 0;
  }

  .api-steps div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .api-steps span {
    margin: 0;
  }

  .limits {
    padding-left: 18px;
  }

  @media (max-width: 900px) {
    .analysis-page {
      width: min(100% - 24px, 760px);
    }

    .analysis-hero,
    .grid-two,
    .chart-foot {
      grid-template-columns: 1fr;
    }

    .analysis-hero {
      min-height: auto;
