---
import "../styles/global.css";
import payloadJson from "../data/siming-alerts.json";

const payload = payloadJson as any;
const district = payload.district.analysis;
const weekly = payload.district.weekly;
const forecast = district.forecast || [];
const streetPanels = payload.street_panels || [];
const methodology = payload.methodology || {};
const riskCounts = payload.summary.risk_by_scope?.community || {};

const width = 1120;
const height = 430;
const margin = { top: 34, right: 34, bottom: 58, left: 62 };
const plotW = width - margin.left - margin.right;
const plotH = height - margin.top - margin.bottom;
const values = [...weekly.map((d: any) => d.count), ...forecast.map((d: any) => d.count)];
const maxY = Math.max(10, Math.ceil(Math.max(...values) / 100) * 100);
const minY = 0;
const allX = [...weekly, ...forecast];
const x = (index: number) => margin.left + (index / Math.max(1, allX.length - 1)) * plotW;
const y = (value: number) => margin.top + (1 - (value - minY) / Math.max(1, maxY - minY)) * plotH;
const actualPts = weekly.map((d: any, i: number) => ({ ...d, x: x(i), y: y(d.count) }));
const forecastPts = forecast.map((d: any, i: number) => ({ ...d, x: x(weekly.length + i), y: y(d.count) }));
const joinedForecastPts = actualPts.length && forecastPts.length ? [actualPts[actualPts.length - 1], ...forecastPts] : forecastPts;
const peak = weekly.reduce((best: any, item: any) => (item.count > best.count ? item : best), weekly[0]);
const peakIndex = weekly.findIndex((d: any) => d.week_start === peak.week_start);
const fluStartIndex = weekly.findIndex((d: any) => d.iso_week.endsWith("W40"));
const xTickIndexes = [0, 10, 20, 30, 40, weekly.length - 1].filter((item, index, arr) => item >= 0 && item < weekly.length && arr.indexOf(item) === index);

function smoothPath(points: any[]) {
  if (points.length < 2) return "";
  const path = [`M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`];
  for (let i = 0; i < points.length - 1; i += 1) {
    const p0 = points[Math.max(0, i - 1)];
    const p1 = points[i];
    const p2 = points[i + 1];
    const p3 = points[Math.min(points.length - 1, i + 2)];
    const cp1x = p1.x + (p2.x - p0.x) / 6;
    const cp1y = p1.y + (p2.y - p0.y) / 6;
    const cp2x = p2.x - (p3.x - p1.x) / 6;
    const cp2y = p2.y - (p3.y - p1.y) / 6;
    path.push(`C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)}, ${cp2x.toFixed(1)} ${cp2y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`);
  }
  return path.join(" ");
}

const actualPath = smoothPath(actualPts);
const forecastPath = smoothPath(joinedForecastPts);
const areaPath = actualPts.length
  ? `${actualPath} L ${actualPts[actualPts.length - 1].x.toFixed(1)} ${y(0).toFixed(1)} L ${actualPts[0].x.toFixed(1)} ${y(0).toFixed(1)} Z`
  : "";
const yTicks = [0, Math.round(maxY * 0.25), Math.round(maxY * 0.5), Math.round(maxY * 0.75), maxY];

function pct(value: number | null) {
  if (value === null || Number.isNaN(value)) return "--";
  return `${Math.round(value * 100)}%`;
}

function metric(value: number | null, digits = 1) {
  if (value === null || Number.isNaN(value)) return "--";
  return Number(value).toLocaleString("zh-CN", { maximumFractionDigits: digits });
}

function modelLabel(name: string) {
  const labels: Record<string, string> = {
    naive_last: "最近值延续",
    moving_average_4: "4周移动均值",
    damped_trend: "阻尼趋势",
    croston_sba: "Croston-SBA",
    poisson_harmonic: "泊松谐波"
  };
  return labels[name] || name || "未入模";
}

function gateLabel(reason: string) {
  const labels: Record<string, string> = {
    eligible: "进入短期参考",
    low_total_count: "总量过低",
    too_few_nonzero_weeks: "非零周不足",
    zero_inflated_sparse: "零膨胀",
    single_spike_dominates: "单周尖峰主导",
    too_unstable_for_routine_forecast: "波动过强",
    insufficient_weeks: "周数不足"
  };
  if (!reason || reason === "eligible") return labels.eligible;
  return reason.split(";").map((item) => labels[item] || item).join(" / ");
}

function riskStyle(item: any) {
  return `--risk:${item?.risk?.color || "#22c55e"}`;
}

function countForecast(item: any) {
  return item.forecast?.map((row: any) => row.count).join(" / ") || "仅监测";
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="思明区学校预警信号周序列、风险分级、模型筛选与社区风险矩阵。" />
    <link rel="icon" href="/favicon.svg" />
    <title>思明区预警信号风险矩阵 | CNalks</title>
  </head>
  <body class="analysis-body">
    <div class="analysis-page">
      <header class="analysis-topbar">
        <a class="back-link" href="/">CNalks</a>
        <nav>
          <a href="#series">趋势</a>
          <a href="#matrix">风险矩阵</a>
          <a href="#method">方法</a>
          <a href="#api">AI_lab</a>
        </nav>
      </header>

      <main>
        <section class="analysis-hero">
          <div>
            <p class="analysis-kicker">weekly signal study · Siming District</p>
            <h1>学校预警信号风险矩阵</h1>
            <p class="analysis-copy">
              将 3508 条预警信号按 ISO 周聚合为全区、街道和 87 个社区序列。页面先做风险分级，再说明哪些序列适合短期参考、哪些序列只用于监测。
            </p>
            <div class="hero-badges">
              <span>{payload.source.date_min} 至 {payload.source.date_max}</span>
              <span>按 {payload.source.date_column} 聚合</span>
              <span>社区口径：F列 87 个观测社区</span>
            </div>
          </div>
          <div class="hero-metrics" aria-label="关键指标">
            <div>
              <small>社区高风险</small>
              <strong>{riskCounts.alert || 0}</strong>
            </div>
            <div>
              <small>社区预警/关注</small>
              <strong>{(riskCounts.warning || 0) + (riskCounts.watch || 0)}</strong>
            </div>
            <div>
              <small>可入模序列</small>
              <strong>{payload.summary.forecast_eligible_count}</strong>
            </div>
            <div>
              <small>总序列</small>
              <strong>{payload.summary.series_count}</strong>
            </div>
          </div>
        </section>

        <section class="analysis-section chart-section" id="series">
          <div class="section-heading">
            <div>
              <p class="analysis-kicker">district trend</p>
              <h2>全区周信号量与短期参考</h2>
            </div>
            <div class="chart-legend" aria-label="图例">
              <span><i class="actual-dot"></i>观测</span>
              <span><i class="forecast-dot"></i>短期参考</span>
            </div>
          </div>

          <div class="chart-shell">
            <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="思明区每周预警信号数曲线">
              <rect x="0" y="0" width={width} height={height} rx="8" fill="#101713" />
              {yTicks.map((tick) => (
                <g>
                  <line x1={margin.left} x2={width - margin.right} y1={y(tick)} y2={y(tick)} stroke="rgba(229,239,232,.13)" />
                  <text x={margin.left - 14} y={y(tick) + 5} text-anchor="end" class="axis-text">{tick}</text>
                </g>
              ))}
              {fluStartIndex >= 0 && (
                <g>
                  <rect x={x(fluStartIndex)} y={margin.top} width={(width - margin.right - x(fluStartIndex)).toFixed(1)} height={plotH} fill="rgba(251,191,36,.06)" />
                  <line x1={x(fluStartIndex)} x2={x(fluStartIndex)} y1={margin.top} y2={height - margin.bottom} stroke="rgba(251,191,36,.55)" stroke-dasharray="5 7" />
                  <text x={x(fluStartIndex) + 10} y={margin.top + 18} class="axis-note">流感监测季 W40 起</text>
                </g>
              )}
              {forecastPts.length > 0 && (
                <g>
                  <rect x={forecastPts[0].x} y={margin.top} width={(width - margin.right - forecastPts[0].x).toFixed(1)} height={plotH} fill="rgba(251,113,133,.06)" />
                  <line x1={forecastPts[0].x} x2={forecastPts[0].x} y1={margin.top} y2={height - margin.bottom} stroke="rgba(251,113,133,.65)" stroke-dasharray="5 7" />
                  <text x={forecastPts[0].x + 10} y={height - margin.bottom - 12} class="axis-note">两周参考</text>
                </g>
              )}
              {areaPath && <path d={areaPath} fill="url(#actualArea)" />}
              <defs>
                <linearGradient id="actualArea" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="#7dd3fc" stop-opacity=".24" />
                  <stop offset="100%" stop-color="#7dd3fc" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path d={actualPath} fill="none" stroke="#7dd3fc" stroke-width="4" stroke-linecap="round" />
              {forecastPath && <path d={forecastPath} fill="none" stroke="#fb7185" stroke-width="4" stroke-dasharray="10 9" stroke-linecap="round" />}
              {actualPts.map((point: any, index: number) => index % 5 === 0 || point.count === peak.count ? (
                <circle cx={point.x} cy={point.y} r="4" fill="#101713" stroke="#7dd3fc" stroke-width="2">
                  <title>{point.iso_week}: {point.count}</title>
                </circle>
              ) : null)}
              {forecastPts.map((point: any) => (
                <circle cx={point.x} cy={point.y} r="5" fill="#101713" stroke="#fb7185" stroke-width="2.4">
                  <title>{point.iso_week}: {point.count}</title>
                </circle>
              ))}
              {peakIndex >= 0 && (
                <g>
                  <line x1={x(peakIndex)} x2={x(peakIndex)} y1={y(peak.count)} y2={height - margin.bottom} stroke="rgba(125,211,252,.22)" />
                  <text x={x(peakIndex) + 8} y={y(peak.count) - 10} class="axis-note">峰值 {peak.iso_week} · {peak.count}</text>
                </g>
              )}
              {xTickIndexes.map((index) => (
                <g>
                  <line x1={x(index)} x2={x(index)} y1={height - margin.bottom} y2={height - margin.bottom + 6} stroke="rgba(229,239,232,.35)" />
                  <text x={x(index)} y={height - margin.bottom + 26} text-anchor="middle" class="axis-text">{weekly[index].iso_week}</text>
                </g>
              ))}
            </svg>
          </div>

          <div class="chart-foot">
            <div>
              <strong>全区风险：{district.risk.label} · {district.risk.score}</strong>
              <span>{district.risk.basis}；当前周为 {district.risk.current_label}。</span>
            </div>
            <div>
              <strong>{modelLabel(district.best_model)}</strong>
              <span>滚动回测最优；MAE {metric(district.mae)}，RMSE {metric(district.rmse)}。未来 {payload.summary.horizon_weeks} 周只作为短期参考。</span>
            </div>
          </div>
        </section>

        <section class="analysis-section" id="matrix">
          <div class="section-heading">
            <div>
              <p class="analysis-kicker">street · community matrix</p>
              <h2>街道-社区风险矩阵</h2>
            </div>
            <div class="risk-legend" aria-label="风险图例">
              {methodology.risk_levels?.map((item: any) => (
                <span class={`risk-${item.level}`}><i></i>{item.label}</span>
              ))}
            </div>
          </div>

          <div class="street-stack">
            {streetPanels.map((street: any, index: number) => (
              <details class="street-card" open={index < 2} style={riskStyle(street)}>
                <summary>
                  <div class="street-main">
                    <span class="risk-dot" title={street.risk.label}></span>
                    <div>
                      <strong>{street.name}</strong>
                      <small>{street.risk.label} · 分数 {street.risk.score} · 峰值 {street.risk.period_peak_count}（{street.risk.period_peak_week}）</small>
                    </div>
                  </div>
                  <div class="community-dots" aria-label={`${street.name}社区风险点阵`}>
                    {street.communities.map((item: any) => (
                      <span class="mini-dot" style={riskStyle(item)} title={`${item.name}：${item.risk.label}，峰值 ${item.risk.period_peak_count}`}></span>
                    ))}
                  </div>
                  <div class="street-counts">
                    <span>高 {street.community_risk_counts.alert || 0}</span>
                    <span>预 {street.community_risk_counts.warning || 0}</span>
                    <span>关 {street.community_risk_counts.watch || 0}</span>
                    <span>常 {street.community_risk_counts.normal || 0}</span>
                  </div>
                </summary>
                <div class="street-detail">
                  <div class="street-explain">
                    <span>{street.risk.basis}</span>
                    <span>当前周 {street.risk.current_count}，短基线 {metric(street.risk.baseline_mean, 2)} ± {metric(street.risk.baseline_sd, 2)}。</span>
                    <span>模型：{modelLabel(street.best_model)}；两周参考 {countForecast(street)}。</span>
                  </div>
                  <div class="community-list">
                    {street.communities.map((item: any) => (
                      <article class="community-item" style={riskStyle(item)}>
                        <div class="community-title">
                          <span class="risk-dot"></span>
                          <strong>{item.name}</strong>
                          <small>{item.risk.label} · {item.risk.score}</small>
                        </div>
                        <div class="community-metrics">
                          <span>总量 <b>{item.total}</b></span>
                          <span>当前 <b>{item.risk.current_count}</b></span>
                          <span>峰值 <b>{item.risk.period_peak_count}</b></span>
                          <span>零值 <b>{pct(item.zero_ratio)}</b></span>
                        </div>
                        <p>{item.risk.basis}</p>
                        <small>{gateLabel(item.gate_reason)} · {modelLabel(item.best_model)} · 两周参考 {countForecast(item)}</small>
                      </article>
                    ))}
                  </div>
                </div>
              </details>
            ))}
          </div>
        </section>

        <section class="analysis-section method-section" id="method">
          <div class="section-heading">
            <div>
              <p class="analysis-kicker">method readme</p>
              <h2>怎样分级、为什么这样建模</h2>
            </div>
          </div>
          <div class="method-grid">
            <article class="method-panel">
              <h3>风险分级</h3>
              <p>主等级表示“本监测季内是否出现过需要复核的异常强度”，详细栏同时显示当前周状态，避免把已经回落的序列误读为仍在暴发。</p>
              <div class="level-list">
                {methodology.risk_levels?.map((item: any) => (
                  <div class={`level-row risk-${item.level}`}>
                    <i></i>
                    <span><b>{item.label}</b>{item.meaning}</span>
                  </div>
                ))}
              </div>
            </article>
            <article class="method-panel">
              <h3>5 个候选模型</h3>
              <p>这些是本地 fallback 实验集，用于 51 周短序列的滚动回测；线上 AI_lab 正式预测接口目前因 60 点门槛返回 insufficient data。</p>
              <div class="model-note-list">
                {methodology.model_notes?.map((item: any) => (
                  <div>
                    <strong>{item.label}</strong>
                    <span>{item.why}</span>
                  </div>
                ))}
              </div>
            </article>
            <article class="method-panel">
              <h3>为什么有些序列只监测</h3>
              <ul>
                {methodology.gate_rules?.map((item: string) => <li>{item}</li>)}
              </ul>
              <p>本次结果：全区 1 条、街道 10 条全部入模；社区 87 条中 51 条入模，36 条保留为监测序列。</p>
            </article>
            <article class="method-panel">
              <h3>依据来源</h3>
              <ul class="source-list">
                {methodology.sources?.map((item: any) => (
                  <li><a href={item.url}>{item.title}</a><span>{item.used_for}</span></li>
                ))}
              </ul>
            </article>
          </div>
        </section>

        <section class="analysis-section grid-two" id="api">
          <div class="model-panel">
            <p class="analysis-kicker">AI_lab probe</p>
            <h2>接口测试结论</h2>
            <div class="api-steps">
              <div><span>模型元数据</span><strong>HTTP 200</strong></div>
              <div><span>临时序列写入</span><strong>201 · 51 点</strong></div>
              <div><span>训练</span><strong>成功</strong></div>
              <div><span>预测运行</span><strong>insufficient data</strong></div>
            </div>
            <p>AI_lab 的通用 series/data/train 链路可用；本页暂用本地批量实验承接展示，并保留结构化指标，便于后续迁回后端。</p>
          </div>
          <div class="model-panel">
            <p class="analysis-kicker">data limits</p>
            <h2>解释边界</h2>
            <ul class="limits">
              {payload.limitations.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

<style>
  .analysis-body {
    background:
      radial-gradient(circle at 16% 10%, rgba(125, 211, 252, .14), transparent 34%),
      radial-gradient(circle at 86% 12%, rgba(239, 68, 68, .10), transparent 32%),
      linear-gradient(180deg, #0d1110, #121715 46%, #0f1212);
  }

  .analysis-page {
    width: min(1240px, calc(100% - 36px));
    margin: 0 auto;
    padding-bottom: 64px;
  }

  .analysis-topbar {
    height: 66px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .analysis-topbar a {
    color: var(--muted);
    text-decoration: none;
  }

  .analysis-topbar nav {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .back-link {
    font-weight: 800;
    color: var(--ink) !important;
  }

  .analysis-hero {
    min-height: 520px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    gap: 42px;
    align-items: center;
  }

  .analysis-kicker {
    margin: 0 0 10px;
    color: var(--green);
    font-size: 13px;
    text-transform: uppercase;
  }

  .analysis-hero h1 {
    max-width: 860px;
    margin: 0;
    font-size: clamp(42px, 7vw, 84px);
    line-height: .98;
  }

  .analysis-copy {
    max-width: 760px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-badges,
  .chart-legend,
  .risk-legend {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hero-badges span,
  .chart-legend span,
  .risk-legend span {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 12px;
    color: var(--muted);
    background: rgba(255,255,255,.04);
    font-size: 13px;
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .hero-metrics div,
  .model-panel,
  .chart-shell,
  .street-card,
  .method-panel {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(16, 23, 19, .76);
    box-shadow: 0 22px 70px rgba(0,0,0,.22);
  }

  .hero-metrics div {
    padding: 24px;
  }

  .hero-metrics small,
  .street-main small,
  .community-item small,
  .policy-grid small {
    color: var(--muted);
  }

  .hero-metrics strong {
    display: block;
    margin-top: 10px;
    font-size: clamp(32px, 4vw, 54px);
  }

  .analysis-section {
    margin-top: 28px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
  }

  .section-heading h2,
  .model-panel h2 {
    margin: 0;
    font-size: 28px;
  }

  .chart-shell {
    overflow: hidden;
  }

  .chart-shell svg {
    width: 100%;
    display: block;
  }

  .axis-text {
    fill: #9aa9a3;
    font-size: 13px;
  }

  .axis-note {
    fill: #cbd8d2;
    font-size: 14px;
  }

  .actual-dot,
  .forecast-dot {
    width: 18px;
    height: 3px;
    display: inline-block;
    border-radius: 999px;
    background: #7dd3fc;
  }

  .forecast-dot {
    background: #fb7185;
  }

  .chart-foot {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .chart-foot div,
  .street-explain {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 15px;
    background: rgba(255,255,255,.035);
  }

  .chart-foot strong,
  .chart-foot span,
  .street-explain span {
    display: block;
  }

  .chart-foot span,
  .model-panel p,
  .community-item p,
  .limits,
  .method-panel p,
  .method-panel li {
    color: var(--muted);
    line-height: 1.65;
  }

  .street-stack {
    display: grid;
    gap: 12px;
  }

  .street-card {
    overflow: hidden;
  }

  .street-card summary {
    display: grid;
    grid-template-columns: minmax(220px, .75fr) minmax(280px, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 16px;
    cursor: pointer;
    list-style: none;
  }

  .street-card summary::-webkit-details-marker {
    display: none;
  }

  .street-main,
  .community-title {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .street-main strong,
  .street-main small,
  .community-title strong,
  .community-title small {
